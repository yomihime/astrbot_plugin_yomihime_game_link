{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "vue": [
        "./node_modules/vue"
      ],
      "naive-ui": [
        "./node_modules/naive-ui"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "../../modules/ff14/pages/src/**/*.ts"
  ]
}
