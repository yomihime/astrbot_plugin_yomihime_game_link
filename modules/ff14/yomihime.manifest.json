                "type": "integer",
                "minimum": 1,
                "maximum": 30
              },
              "timezone": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "region"
            ],
            "additionalProperties": false
          },
          "invocation_policy": "command_and_public_web",
          "effect": "read_only",
          "privacy_floor": "public"
        },
        {
          "capability_id": "ff14.calendar.subscription.create",
          "input_schema": {
            "type": "object",
            "properties": {
