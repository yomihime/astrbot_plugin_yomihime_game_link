      "commands": [
        {
          "operation_path": "market",
          "capability_id": "ff14.market.query",
          "parameter_mapping": {},
          "parameter_mode": "raw_tail",
          "raw_tail_parameter": "command",
          "help_text": "\u67e5\u8be2\u7269\u54c1\u5e02\u573a\u4ef7\u683c\u4e0e\u6709\u9650\u6302\u724c\u6837\u672c\u3002\n\u7528\u6cd5\uff1a/ygl ff14 market <\u7269\u54c1\u540d\u6216ID> [server=World dc=\u5927\u533a region=cn|global quality=all|nq|hq intent=overview|min|listings]\n\u7269\u54c1\u540d\u53ef\u7528\u53cc\u5f15\u53f7\u4fdd\u62a4\uff1b\u8303\u56f4\u53ef\u7ec4\u5408\u4f46\u5fc5\u987b\u4e00\u81f4\uff1bserver \u4f18\u5148\u4e8e dc\uff0cdc \u4f18\u5148\u4e8e region\uff1b\u7701\u7565\u8303\u56f4\u8bfb\u53d6 Core \u9ed8\u8ba4\u533a\u57df\uff0c\u7701\u7565\u54c1\u8d28\u4e3a all\uff0c\u7701\u7565\u610f\u56fe\u4e3a overview\u3002\u6700\u4f4e\u4ef7\u7528 min\uff0c\u6302\u724c\u660e\u7ec6\u6700\u591a\u4e94\u6761\uff0c\u4e0d\u4ee3\u8868\u5b8c\u6574 World \u8986\u76d6\u6216\u5b9e\u65f6\u53ef\u4e70\uff1b\u65f6\u95f4\u4e3a\u6765\u6e90\u4e0a\u4f20\u65f6\u95f4\uff0c\u4e0d\u662f\u6302\u724c\u65f6\u95f4\u3002\n\u6b67\u4e49\u540d\u79f0\u987b\u660e\u786e\u9009\u62e9\uff1bchoose <\u6279\u6b21> <generation> <\u7269\u54c1ID> \u7eed\u63a5\u5f53\u524d\u5019\u9009\uff0c\u4e0d\u66ff\u7528\u6237\u9009\u62e9\u3002\n\u793a\u4f8b\uff1a/ygl ff14 market \u728e\u725b\u725b\u6392 region=cn intent=min"
        },
        {
          "operation_path": "status",
          "capability_id": "status",
          "parameter_mapping": {},
          "help_text": "\u67e5\u770b\u6a21\u5757\u72b6\u6001\u3001\u51ed\u636e\u8981\u6c42\u4e0e\u6570\u636e\u6e90\u9650\u5236\u3002\n\u7528\u6cd5\uff1a/ygl ff14 status"
        },
        {
          "operation_path": "item",
          "capability_id": "item.lookup",
          "parameter_mapping": {
            "query": "query"
          },
          "help_text": "\u6309\u540d\u79f0\u6216 ID \u67e5\u8be2\u7269\u54c1\u4fe1\u606f\u4e0e\u5df2\u9a8c\u8bc1\u83b7\u53d6\u9014\u5f84\u3002\n\u7528\u6cd5\uff1a/ygl ff14 item <\u7269\u54c1\u540d\u79f0\u6216\u6570\u5b57ID>\n\u793a\u4f8b\uff1a/ygl ff14 item \u94dc\u77ff"
        },
        {
          "operation_path": "logs",
          "capability_id": "ff14.logs.character",
          "parameter_mapping": {
            "realm": "realm",
            "server": "server",
            "character": "character",
            "server_hint": "server_hint",
            "metric": "metric",
            "zone_id": "zone_id",
            "difficulty": "difficulty",
            "partition": "partition"
          },
          "help_text": "\u67e5\u8be2 FFLogs \u516c\u5f00\u89d2\u8272\u6218\u7ee9\uff1b\u9700\u5bf9\u5e94\u533a\u57df\u51ed\u636e\u3002\n\u7528\u6cd5\uff1a/ygl ff14 logs <\u56fd\u670d|\u56fd\u9645\u670d> <\u670d\u52a1\u5668\u540d> <\u89d2\u8272\u540d> [server_hint=\u540d\u79f0] [metric=rdps|ndps|cdps] [zone_id=N difficulty=N partition=N]\n\u56fd\u670d\u4e0e\u56fd\u9645\u670d\u51ed\u636e\u5206\u5f00\u914d\u7f6e\uff1b\u672a\u914d\u7f6e\u65f6\u7269\u54c1\u3001\u5e02\u573a\u548c\u65e5\u5386\u4ecd\u53ef\u4f7f\u7528\u3002\u89d2\u8272\u540d\u542b\u7a7a\u683c\u53ef\u7528\u53cc\u5f15\u53f7\u3002"
        },
        {
          "operation_path": "output",
          "capability_id": "ff14.logs.output_percentile",
          "parameter_mapping": {
            "realm": "realm",
            "encounter": "encounter",
            "difficulty": "difficulty",
            "job": "job",
            "metric": "metric",
            "period": "period"
          },
          "help_text": "\u67e5\u8be2 FFLogs \u8f93\u51fa\u7edf\u8ba1\uff1b\u5f53\u524d\u6765\u6e90\u4e0d\u53ef\u7528\u3002\n\u7528\u6cd5\uff1a/ygl ff14 output <\u56fd\u670d|\u56fd\u9645\u670d> <\u526f\u672c\u540d\u79f0> <\u96be\u5ea6> <\u804c\u4e1a> [metric=rdps] [period=latest]\nFFLogs \u7edf\u8ba1\u9875\u9762\u5f53\u524d\u56e0 HTTP 403 \u6682\u4e0d\u53ef\u7528\uff0c\u6570\u636e\u683c\u5f0f\u5c1a\u672a\u9a8c\u8bc1\u3002"
        },
        {
          "operation_path": "calendar",
          "capability_id": "ff14.calendar.query",
          "parameter_mapping": {
            "region": "region",
            "days": "days",
            "timezone": "timezone"
          },
          "help_text": "\u67e5\u8be2\u6d3b\u52a8\u65e5\u5386\u3002\n\u7528\u6cd5\uff1a/ygl ff14 calendar <\u56fd\u670d|\u56fd\u9645\u670d> [days=7] [timezone=Asia/Shanghai]\n\u7701\u7565 days \u4e0e timezone \u8bfb\u53d6\u6a21\u5757\u914d\u7f6e\uff1bdays \u4e3a 1\u201330\uff0c\u8303\u56f4\u4ece\u6307\u5b9a\u65f6\u533a\u7684\u672c\u5730\u65e5\u671f\u8d77\u7b97\u3002"
        },
        {
          "operation_path": "calendar subscribe",
          "capability_id": "ff14.calendar.subscription.create",
          "parameter_mapping": {
            "region": "region",
            "timezone": "timezone",
            "time": "time"
          },
          "help_text": "\u663e\u5f0f\u521b\u5efa\u672c\u4eba\u6bcf\u65e5\u6458\u8981\u8ba2\u9605\u3002\n\u7528\u6cd5\uff1a/ygl ff14 calendar subscribe <\u56fd\u670d|\u56fd\u9645\u670d> [timezone=Asia/Shanghai] [time=08:00]\n\u4ec5\u672c\u4eba\u79c1\u804a\uff1b\u7701\u7565 timezone \u4e0e time \u8bfb\u53d6\u6a21\u5757\u914d\u7f6e\uff1b\u6bcf 15 \u5206\u949f\u91c7\u96c6\u4e00\u6b21\uff0c\u4e0d\u627f\u8bfa\u8bbe\u5b9a\u65f6\u523b\u7cbe\u51c6\u6295\u9012\u3002"
        },
        {
          "operation_path": "calendar subscriptions",
          "capability_id": "ff14.calendar.subscription.list",
          "parameter_mapping": {
            "page": "page"
          },
          "help_text": "\u5206\u9875\u67e5\u770b\u672c\u4eba\u65e5\u5386\u8ba2\u9605\u3002\n\u7528\u6cd5\uff1a/ygl ff14 calendar subscriptions [page=1]\n\u4ec5\u672c\u4eba\u79c1\u804a\uff1bpage \u4ece 1 \u8d77\u3002"
        },
        {
          "operation_path": "calendar update",
          "capability_id": "ff14.calendar.subscription.update",
          "parameter_mapping": {
            "subscription_id": "subscription_id",
            "expected_revision": "expected_revision",
            "timezone": "timezone",
            "time": "time"
          },
          "help_text": "\u66f4\u65b0\u672c\u4eba\u8ba2\u9605\u5e76\u6821\u9a8c\u7248\u672c\u3002\n\u7528\u6cd5\uff1a/ygl ff14 calendar update <subscription-id> <expected-revision> [timezone=IANA] [time=HH:MM]\n\u4ec5\u672c\u4eba\u79c1\u804a\uff1b\u4f7f\u7528 subscriptions \u8fd4\u56de\u7684 ID \u4e0e revision\uff0c\u81f3\u5c11\u6307\u5b9a\u4e00\u4e2a\u66f4\u65b0\u5b57\u6bb5\u3002"
        },
        {
          "operation_path": "calendar cancel",
          "capability_id": "ff14.calendar.subscription.cancel",
          "parameter_mapping": {
            "subscription_id": "subscription_id",
            "expected_revision": "expected_revision"
          },
          "help_text": "\u53d6\u6d88\u672c\u4eba\u8ba2\u9605\u5e76\u6821\u9a8c\u7248\u672c\u3002\n\u7528\u6cd5\uff1a/ygl ff14 calendar cancel <subscription-id> <expected-revision>\n\u4ec5\u672c\u4eba\u79c1\u804a\uff1b\u4f7f\u7528 subscriptions \u8fd4\u56de\u7684 ID \u4e0e revision\u3002"
        }
      ],
      "tools": [
        {
          "name": "ff14_market_query",
          "capability_id": "ff14.market.query",
          "parameter_mapping": {
            "query": "query",
            "server": "server",
            "dc": "dc",
            "region": "region",
            "quality": "quality",
            "intent": "intent"
          },
          "description": "Query public FF14 per-item Gil prices by an item name or ID explicitly present in the current user message. Scope: server/dc/region; quality: all/nq/hq; intent: overview/min/listings. On ambiguity show candidate names and ask for one unique full name (or full name + \u90a3\u4e2a). Never guess or query a pending candidate to bypass selection; use select to preserve context. Ordinal choices are unsupported. For lowest price / where cheapest (including Chinese equivalents), prefer intent=min; overview is for general market metrics. After success or usable partial facts suffice, answer directly; do not query extra servers without a new explicit user scope. Place Universalis source, fetched/cache age, price source age and limited coverage/non-realtime caveat next to prices. Use verified world_name only; unknown stays unknown. Do not infer HQ uses, restocking or purchase advice. On errors explain briefly and await user clarification; never change query parameters to bypass confirmation. Titles, table headers and prices must say lowest listing in the data returned for this query; listings are at most five finite samples, never a complete list. minimums.time is World data upload; listings.reviewed is source last review and listings.uploaded is World upload, none is listing creation time. source.fetched_at/fetched_age_seconds describes retrieval separately from price source age; unknown times remain unknown. Avoid realtime-price or realtime-interface wording."
        },
        {
          "name": "ff14_market_select",
          "capability_id": "ff14.market.select",
          "parameter_mapping": {
            "batch_id": "batch_id",
            "generation": "generation",
            "item_id": "item_id"
          },
          "description": "Continue the current user's pending FF14 query only after a new user message confirms a unique full candidate name: name, name + \u90a3\u4e2a, \u9009/\u9009\u62e9/\u5c31/\u5c31\u9009 + name; or \u9009\u62e9\u7269\u54c1 <ID>. Use prior batch_id/generation and the matching item_id. The module validates the real event, not model assertions. Questions, negations, multiple names, duplicate names and ordinal choices require clarification. Preserve original scope, quality, intent and configuration revisions. After success or usable partial facts suffice, answer directly with source and limited coverage/non-realtime caveat adjacent to prices; do not issue extra server queries without a new user instruction. Unknown world names remain unknown; do not infer HQ uses or restocking advice. Titles, table headers and prices must say lowest listing in the data returned for this query; listings are at most five finite samples, never a complete list. minimums.time is World data upload; listings.reviewed is source last review and listings.uploaded is World upload, none is listing creation time. source.fetched_at/fetched_age_seconds describes retrieval separately from price source age; unknown times remain unknown. Avoid realtime-price or realtime-interface wording."
        }
      ],
