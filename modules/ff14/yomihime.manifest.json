                "enum": [
                  "国服",
                  "国际服",
                  "cn",
                  "global"
                ]
              },
              "timezone": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "time": {
                "type": "string",
                "minLength": 5,
                "maxLength": 5
              }
            },
            "required": [
              "region"
            ],
            "additionalProperties": false
          },
          "invocation_policy": "command_only",
          "effect": "write",
          "privacy_floor": "owner"
        },
        {
          "capability_id": "ff14.calendar.subscription.list",
          "input_schema": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              }
