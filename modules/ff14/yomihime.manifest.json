      ],
      "schedules": [
        {
          "collector_id": "ff14.calendar.collect",
          "key_version": 1,
          "source_id": "ff14_calendar_primary",
          "data_version": 1,
          "input_schema": {
            "type": "object",
            "properties": {
              "region": {
                "type": "string",
                "enum": [
                  "国服",
                  "国际服",
                  "cn",
                  "global"
                ]
              }
            },
            "required": [
              "region"
            ],
            "additionalProperties": false
          },
          "shared_scope": "public",
          "trigger": "periodic",
          "minimum_interval_seconds": 900,
          "default_interval_seconds": 900,
          "interval_config_key": "ff14_calendar_interval_seconds"
        }
      ],
      "subscriptions": [
        {
