            "additionalProperties": false
          },
          "invocation_policy": "command_only",
          "effect": "write",
          "privacy_floor": "owner"
        }
      ],
      "commands": [
        {
          "operation_path": "status",
          "capability_id": "status",
          "parameter_mapping": {},
          "help_text": "查看 FF14 功能状态、凭据要求与已知数据源限制。"
        },
        {
          "operation_path": "item",
          "capability_id": "item.lookup",
          "parameter_mapping": {
            "query": "query"
          },
          "help_text": "按物品名称或数字 ID 查询公开基础信息与已验证的获取途径。"
        },
        {
          "operation_path": "logs",
          "capability_id": "ff14.logs.character",
          "parameter_mapping": {
            "realm": "realm",
            "server": "server",
            "character": "character",
            "server_hint": "server_hint",
            "metric": "metric",
            "zone_id": "zone_id",
            "difficulty": "difficulty",
            "partition": "partition"
          },
          "help_text": "/ygl ff14 logs <国服|国际服> <服务器名> <角色名> [server_hint=名称] [metric=rdps|ndps|cdps] [zone_id=N difficulty=N partition=N]。"
        },
        {
          "operation_path": "output",
          "capability_id": "ff14.logs.output_percentile",
          "parameter_mapping": {
            "realm": "realm",
            "encounter": "encounter",
            "difficulty": "difficulty",
            "job": "job",
            "metric": "metric",
            "period": "period"
          },
          "help_text": "/ygl ff14 output <国服|国际服> <副本名称> <难度> <职业> [metric=rdps] [period=latest]；FFLogs 统计页面当前因 HTTP 403 暂不可用。"
        },
        {
          "operation_path": "calendar",
          "capability_id": "ff14.calendar.query",
          "parameter_mapping": {
            "region": "region",
            "days": "days",
            "timezone": "timezone"
          },
          "help_text": "/ygl ff14 calendar <国服|国际服> [days=7] [timezone=Asia/Shanghai]；范围为本地日期起 7 个日历日。"
        },
        {
          "operation_path": "calendar subscribe",
          "capability_id": "ff14.calendar.subscription.create",
          "parameter_mapping": {
            "region": "region",
            "timezone": "timezone",
            "time": "time"
          },
          "help_text": "/ygl ff14 calendar subscribe <国服|国际服> [timezone=Asia/Shanghai] [time=08:00]；显式创建每日摘要订阅。"
        },
        {
          "operation_path": "calendar subscriptions",
          "capability_id": "ff14.calendar.subscription.list",
          "parameter_mapping": {
            "page": "page"
          },
          "help_text": "/ygl ff14 calendar subscriptions [page=1]"
        },
        {
          "operation_path": "calendar update",
          "capability_id": "ff14.calendar.subscription.update",
          "parameter_mapping": {
            "subscription_id": "subscription_id",
            "expected_revision": "expected_revision",
            "timezone": "timezone",
            "time": "time"
          },
          "help_text": "/ygl ff14 calendar update <subscription-id> <expected-revision> [timezone=IANA] [time=HH:MM]；仅更新本人订阅并校验 revision。"
        },
        {
          "operation_path": "calendar cancel",
          "capability_id": "ff14.calendar.subscription.cancel",
          "parameter_mapping": {
            "subscription_id": "subscription_id",
            "expected_revision": "expected_revision"
          },
          "help_text": "/ygl ff14 calendar cancel <subscription-id> <expected-revision>；仅取消本人订阅并校验 revision。"
        }
      ],
      "tools": [],
      "config_fields": [
        {
          "name": "ff14_subscriptions_enabled",
          "sensitive": false,
          "required": false,
          "default": true,
          "description": "FF14 本人订阅推送开关；暂停保留记录，恢复仅处理之后的未来窗口。"
        },
        {
          "name": "credential_fflogs_cn",
          "sensitive": true,
          "required": false,
          "description": "FFLogs 国服 OAuth 客户端凭据；加密保存，未配置时仅该区战绩查询不可用。"
        },
        {
          "name": "credential_fflogs_global",
          "sensitive": true,
          "required": false,
          "description": "FFLogs 国际服 OAuth 客户端凭据；加密保存，未配置时仅该区战绩查询不可用。"
        }
      ],
