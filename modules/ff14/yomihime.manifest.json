      "module_id": "ff14",
      "route": "ff14",
      "category": "game",
      "factory_entry": "module:Factory",
      "module_version": "0.3.0",
      "capabilities": [
        {
          "capability_id": "status",
          "input_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "invocation_policy": "command_only",
          "effect": "read_only",
          "privacy_floor": "public"
        },
        {
          "capability_id": "item.lookup",
          "input_schema": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "query"
            ],
            "additionalProperties": false
          },
          "invocation_policy": "command_and_public_web",
          "effect": "read_only",
          "privacy_floor": "public",
          "required_sources": [
            "xivapi_items"
          ]
        },
        {
          "capability_id": "ff14.logs.character",
          "input_schema": {
            "type": "object",
            "properties": {
              "realm": {
                "type": "string",
                "enum": [
                  "国服",
                  "国际服",
                  "cn",
                  "global"
                ]
              },
              "server": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "character": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "server_hint": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "metric": {
                "type": "string",
                "enum": [
                  "rdps",
                  "ndps",
                  "cdps"
                ]
              },
              "zone_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "difficulty": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "partition": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            },
            "required": [
              "realm",
              "server",
              "character"
            ],
            "additionalProperties": false
          },
          "invocation_policy": "command_and_public_web",
          "effect": "read_only",
          "privacy_floor": "public"
        },
        {
          "capability_id": "ff14.logs.output_percentile",
          "input_schema": {
            "type": "object",
            "properties": {
              "realm": {
                "type": "string",
                "enum": [
                  "国服",
                  "国际服",
                  "cn",
                  "global"
                ]
              },
              "encounter": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "difficulty": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "job": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "metric": {
                "type": "string",
                "enum": [
                  "rdps",
                  "ndps",
                  "cdps"
                ]
              },
              "period": {
                "type": "string",
                "enum": [
                  "latest"
                ]
              }
            },
            "required": [
              "realm",
              "encounter",
              "difficulty",
              "job"
            ],
            "additionalProperties": false
          },
          "invocation_policy": "command_only",
          "effect": "read_only",
          "privacy_floor": "public"
        },
        {
          "capability_id": "ff14.calendar.query",
          "input_schema": {
