      "commands": [
        {
          "operation_path": "market",
          "capability_id": "ff14.market.query",
          "parameter_mapping": {},
          "parameter_mode": "raw_tail",
          "raw_tail_parameter": "command",
          "help_text": "查询物品市场价格与有限挂牌样本。\n用法：/ygl ff14 market <物品名或ID> [server=World dc=大区 region=cn|global quality=all|nq|hq intent=overview|min|listings]\n物品名可用双引号保护；范围可组合但必须一致；server 优先于 dc，dc 优先于 region；省略范围读取 Core 默认区域，省略品质为 all，省略意图为 overview。最低价用 min，挂牌明细最多五条，不代表完整 World 覆盖或实时可买；时间为来源上传时间，不是挂牌时间。\n歧义名称须明确选择；choose <批次> <generation> <物品ID> 续接当前候选，不替用户选择。\n示例：/ygl ff14 market 犎牛牛排 region=cn intent=min"
        },
        {
          "operation_path": "status",
          "capability_id": "status",
          "parameter_mapping": {},
          "help_text": "查看模块状态、凭据要求与数据源限制。\n用法：/ygl ff14 status"
        },
        {
          "operation_path": "item",
          "capability_id": "item.lookup",
          "parameter_mapping": {
            "query": "query"
          },
          "help_text": "按名称或 ID 查询物品信息与已验证获取途径。\n用法：/ygl ff14 item <物品名称或数字ID>\n示例：/ygl ff14 item 铜矿"
        },
        {
          "operation_path": "logs",
          "capability_id": "ff14.logs.character",
          "parameter_mapping": {
            "realm": "realm",
            "server": "server",
            "character": "character",
            "server_hint": "server_hint",
            "metric": "metric",
            "zone_id": "zone_id",
            "difficulty": "difficulty",
            "partition": "partition"
          },
          "help_text": "查询 FFLogs 公开角色战绩；需对应区域凭据。\n用法：/ygl ff14 logs <国服|国际服> <服务器名> <角色名> [server_hint=名称] [metric=rdps|ndps|cdps] [zone_id=N difficulty=N partition=N]\n国服与国际服凭据分开配置；未配置时物品、市场和日历仍可使用。角色名含空格可用双引号。"
        },
        {
          "operation_path": "output",
          "capability_id": "ff14.logs.output_percentile",
          "parameter_mapping": {
            "realm": "realm",
            "encounter": "encounter",
            "difficulty": "difficulty",
            "job": "job",
            "metric": "metric",
            "period": "period"
          },
          "help_text": "查询 FFLogs 输出统计；当前来源不可用。\n用法：/ygl ff14 output <国服|国际服> <副本名称> <难度> <职业> [metric=rdps] [period=latest]\nFFLogs 统计页面当前因 HTTP 403 暂不可用，数据格式尚未验证。"
        },
        {
          "operation_path": "calendar",
          "capability_id": "ff14.calendar.query",
          "parameter_mapping": {
            "region": "region",
            "days": "days",
            "timezone": "timezone"
          },
          "help_text": "查询活动日历。\n用法：/ygl ff14 calendar <国服|国际服> [days=7] [timezone=Asia/Shanghai]\n省略 days 与 timezone 读取模块配置；days 为 1–30，范围从指定时区的本地日期起算。"
        },
        {
          "operation_path": "calendar subscribe",
          "capability_id": "ff14.calendar.subscription.create",
          "parameter_mapping": {
            "region": "region",
            "timezone": "timezone",
            "time": "time"
          },
          "help_text": "显式创建本人每日摘要订阅。\n用法：/ygl ff14 calendar subscribe <国服|国际服> [timezone=Asia/Shanghai] [time=08:00]\n仅本人私聊；省略 timezone 与 time 读取模块配置；每 15 分钟采集一次，不承诺设定时刻精准投递。"
        },
        {
          "operation_path": "calendar subscriptions",
          "capability_id": "ff14.calendar.subscription.list",
          "parameter_mapping": {
            "page": "page"
          },
          "help_text": "分页查看本人日历订阅。\n用法：/ygl ff14 calendar subscriptions [page=1]\n仅本人私聊；page 从 1 起。"
        },
        {
          "operation_path": "calendar update",
          "capability_id": "ff14.calendar.subscription.update",
          "parameter_mapping": {
            "subscription_id": "subscription_id",
            "expected_revision": "expected_revision",
            "timezone": "timezone",
            "time": "time"
          },
          "help_text": "更新本人订阅并校验版本。\n用法：/ygl ff14 calendar update <subscription-id> <expected-revision> [timezone=IANA] [time=HH:MM]\n仅本人私聊；使用 subscriptions 返回的 ID 与 revision，至少指定一个更新字段。"
        },
        {
          "operation_path": "calendar cancel",
          "capability_id": "ff14.calendar.subscription.cancel",
          "parameter_mapping": {
            "subscription_id": "subscription_id",
            "expected_revision": "expected_revision"
          },
          "help_text": "取消本人订阅并校验版本。\n用法：/ygl ff14 calendar cancel <subscription-id> <expected-revision>\n仅本人私聊；使用 subscriptions 返回的 ID 与 revision。"
        }
      ],
      "tools": [
        {
          "name": "ff14_market_query",
          "capability_id": "ff14.market.query",
          "parameter_mapping": {
            "query": "query",
            "server": "server",
            "dc": "dc",
            "region": "region",
            "quality": "quality",
            "intent": "intent"
          },
          "description": "Query public FF14 per-item Gil prices by an item name or ID explicitly present in the current user message. Scope: server/dc/region; quality: all/nq/hq; intent: overview/min/listings. On ambiguity show candidate names and ask for one unique full name (or full name + 那个). Never guess or query a pending candidate to bypass selection; use select to preserve context. Ordinal choices are unsupported. For lowest price / where cheapest (including Chinese equivalents), prefer intent=min; overview is for general market metrics. After success or usable partial facts suffice, answer directly; do not query extra servers without a new explicit user scope. Place Universalis source, fetched/cache age, price source age and limited coverage/non-realtime caveat next to prices. Use verified world_name only; unknown stays unknown. Do not infer HQ uses, restocking or purchase advice. On errors explain briefly and await user clarification; never change query parameters to bypass confirmation. Titles, table headers and prices must say lowest listing in the data returned for this query; listings are at most five finite samples, never a complete list. minimums.time is World data upload; listings.reviewed is source last review and listings.uploaded is World upload, none is listing creation time. source.fetched_at/fetched_age_seconds describes retrieval separately from price source age; unknown times remain unknown. Avoid realtime-price or realtime-interface wording."
        },
        {
          "name": "ff14_market_select",
          "capability_id": "ff14.market.select",
          "parameter_mapping": {
            "batch_id": "batch_id",
            "generation": "generation",
            "item_id": "item_id"
          },
          "description": "Continue the current user's pending FF14 query only after a new user message confirms a unique full candidate name: name, name + 那个, 选/选择/就/就选 + name; or 选择物品 <ID>. Use prior batch_id/generation and the matching item_id. The module validates the real event, not model assertions. Questions, negations, multiple names, duplicate names and ordinal choices require clarification. Preserve original scope, quality, intent and configuration revisions. After success or usable partial facts suffice, answer directly with source and limited coverage/non-realtime caveat adjacent to prices; do not issue extra server queries without a new user instruction. Unknown world names remain unknown; do not infer HQ uses or restocking advice. Titles, table headers and prices must say lowest listing in the data returned for this query; listings are at most five finite samples, never a complete list. minimums.time is World data upload; listings.reviewed is source last review and listings.uploaded is World upload, none is listing creation time. source.fetched_at/fetched_age_seconds describes retrieval separately from price source age; unknown times remain unknown. Avoid realtime-price or realtime-interface wording."
        }
      ],
