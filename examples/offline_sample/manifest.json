              "module_id": "offline_sample/source",
              "capability_id": "read"
            }
          ]
        },
        {
          "capability_id": "configured_status",
          "input_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "invocation_policy": "natural_language_allowed",
          "effect": "read_only",
          "required_config": ["region"]
        },
        {
          "capability_id": "account_bind",
          "input_schema": {
            "type": "object",
            "properties": {
              "provider": {"type": "string"},
              "subject": {"type": "string"}
            },
            "required": ["provider", "subject"],
            "additionalProperties": false
          },
          "invocation_policy": "command_only",
          "effect": "write"
        },
        {
          "capability_id": "account_list",
          "input_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "invocation_policy": "command_only",
          "effect": "read_only"
        },
        {
          "capability_id": "account_unbind",
          "input_schema": {
            "type": "object",
            "properties": {
              "binding_id": {"type": "string"},
              "expected_revision": {"type": "integer", "minimum": 1}
            },
            "required": ["binding_id", "expected_revision"],
            "additionalProperties": false
          },
          "invocation_policy": "command_only",
          "effect": "write"
        },
        {
          "capability_id": "subscription_create",
          "input_schema": {
            "type": "object",
            "properties": {
              "type_id": {
                "type": "string",
                "enum": ["public_watch", "private_watch"]
              },
              "region": {"type": "string"},
              "minimum": {"type": "integer", "minimum": 0},
              "mode": {"type": "string", "enum": ["instant", "digest"]},
              "digest_time": {"type": "string"}
            },
            "required": ["type_id", "region", "minimum", "mode"],
            "additionalProperties": false
          },
          "invocation_policy": "command_only",
          "effect": "write"
        },
        {
          "capability_id": "subscription_list",
          "input_schema": {
            "type": "object",
            "properties": {},
            "required": [],
