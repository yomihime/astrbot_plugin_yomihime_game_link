          },
          "invocation_policy": "command_only",
          "effect": "read_only"
        },
        {
          "capability_id": "subscription_cancel",
          "input_schema": {
            "type": "object",
            "properties": {
              "subscription_id": {"type": "string"},
              "expected_revision": {"type": "integer", "minimum": 1}
            },
            "required": ["subscription_id", "expected_revision"],
            "additionalProperties": false
          },
          "invocation_policy": "command_only",
          "effect": "write"
