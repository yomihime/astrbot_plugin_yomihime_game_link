      "module_version": "1.0.0",
      "capabilities": [
        {
          "capability_id": "status",
          "input_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "invocation_policy": "natural_language_allowed",
          "effect": "read_only"
        },
        {
          "capability_id": "from_source",
          "input_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "invocation_policy": "natural_language_allowed",
          "effect": "read_only",
          "required_capabilities": [
