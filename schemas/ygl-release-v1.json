{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ygl.invalid/schemas/ygl-release-v1.json",
  "title": "YGL signed release v1",
  "description": "UTF-8 JSON at most 2097152 bytes. Signature covers exact raw release.json bytes. Inventory excludes release.json and release.sig.json. payload_digest hashes records ordered by UTF-8 path bytes, each path UTF-8 + NUL + decimal size ASCII + NUL + lowercase SHA256 ASCII + LF. Parser rejects duplicate keys, unsafe numbers, duplicate and case-colliding paths. Host must compare complete inventory to installed files and reject symlinks.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "plugin_id", "package_id", "release", "channel", "release_sequence", "payload_digest", "files"],
  "properties": {
    "schema": {"const": "ygl.release/1"},
    "plugin_id": {"$ref": "#/$defs/plugin_id"},
    "package_id": {"type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*$"},
    "release": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "channel": {"enum": ["stable", "preview"]},
    "release_sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "payload_digest": {"$ref": "#/$defs/digest"},
    "files": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "object", "additionalProperties": false, "required": ["path", "size", "sha256"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 1024}, "size": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "sha256": {"$ref": "#/$defs/digest"}}}}
  },
  "$defs": {
    "plugin_id": {"type": "object", "additionalProperties": false, "required": ["author", "name"], "properties": {"author": {"type": "string", "minLength": 1, "maxLength": 128}, "name": {"type": "string", "minLength": 1, "maxLength": 128}}},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
