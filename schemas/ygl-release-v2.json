{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ygl.invalid/schemas/ygl-release-v2.json",
  "title": "YGL Host-installed release v2",
  "description": "UTF-8 JSON at most 2097152 bytes. The complete inventory excludes release.json. The package carries no release.sig.json or release-key.json. payload_digest hashes records ordered by UTF-8 path bytes, each path UTF-8 + NUL + decimal size ASCII + NUL + lowercase SHA256 ASCII + LF. Core compares the closed inventory and installed Host identity/version before execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plugin_id", "package_id", "release", "payload_digest", "files"],
  "properties": {
    "schema": {"const": "ygl.release/2"},
    "plugin_id": {"type": "object", "additionalProperties": false, "required": ["author", "name"], "properties": {"author": {"type": "string", "minLength": 1, "maxLength": 128}, "name": {"type": "string", "minLength": 1, "maxLength": 128}}},
    "package_id": {"type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*$"},
    "release": {"type": "string", "maxLength": 128, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "payload_digest": {"$ref": "#/$defs/digest"},
    "files": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "object", "additionalProperties": false, "required": ["path", "size", "sha256"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 1024}, "size": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "sha256": {"$ref": "#/$defs/digest"}}}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
